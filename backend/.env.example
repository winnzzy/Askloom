# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Flutterwave (get these from your Flutterwave dashboard: Settings > API Keys)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_HASH=change_this_and_set_it_as_the_webhook_secret_hash_in_flutterwave_dashboard
FLW_REDIRECT_URL=http://localhost:5173/payment/callback

# Gemini (reused from Content Spark for the "turn into script hook" feature)
GEMINI_API_KEY=your_gemini_api_key

# Email (SMTP provider such as Resend SMTP, Mailgun, Postmark, SendGrid, or SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=AskLoom <noreply@example.com>

# Webhook retry worker
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_RETRY_INTERVAL_MS=60000
