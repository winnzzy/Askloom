# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Flutterwave V4 (Settings > API Keys)
# Use sandbox credentials while testing. Never expose the client secret in frontend code.
FLW_CLIENT_ID=your_flutterwave_v4_client_id
FLW_CLIENT_SECRET=your_flutterwave_v4_client_secret
FLW_SECRET_HASH=change_this_and_set_the_same_value_as_your_flutterwave_webhook_secret
FLW_REDIRECT_URL=http://localhost:5173/payment/callback
FLW_ENVIRONMENT=sandbox

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Email (SMTP provider such as Resend SMTP, Mailgun, Postmark, SendGrid, or SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=AskLoom <noreply@example.com>

# Webhook retry worker
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_RETRY_INTERVAL_MS=60000
